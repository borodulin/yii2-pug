{
    "name": "conquer/pug",
    "description": "Pug renderer for the Yii2 framework",
    "keywords": [
        "yii2",
        "jade",
        "pug",
        "renderer"
    ],
    "homepage": "https://github.com/borodulin/yii2-pug",
    "type": "yii2-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/borodulin/yii2-pug/issues",
        "source": "https://github.com/borodulin/yii2-pug"
    },
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "~2.0.14",
        "pug-php/pug": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "conquer\\pug\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.1.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "conquer\\pug\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "nodejs-php-fallback/nodejs-php-fallback": false
        }
    }
}
